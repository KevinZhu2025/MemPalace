# Copy this file to .env. Keep secrets in Windows environment variables or Azure Key Vault.
## Agent Plan requires its dedicated /api/plan/v3 endpoint and API Key.
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# Use models enabled for the Agent Plan API Key.
ARK_TEXT_MODEL=
ARK_IMAGE_MODEL=
# Default timeout in seconds for an image-generation request.
ARK_REQUEST_TIMEOUT_SECONDS=180
# Generation runs in a background job, so text generation can wait longer than an HTTP request.
ARK_TEXT_REQUEST_TIMEOUT_SECONDS=300
# Set only when the image model requires more than the default 180 seconds.
ARK_IMAGE_REQUEST_TIMEOUT_SECONDS=
ARK_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60
AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net/

# The batch image script uses DashScope separately.
DASHSCOPE_API_KEY=
# Optional: use a region-specific DashScope compatible endpoint.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# Azure SQL Database connection for server.py
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=MEMPALACE
AZURE_SQL_USER=your-sql-user
# Set to ActiveDirectoryPassword when the Azure SQL server uses AAD-only auth.
AZURE_SQL_AUTHENTICATION=
# Optional when using a complete connection string instead.
AZURE_SQL_CONNECTION_STRING=
# Optional: must be installed on the machine running server.py.
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
HOST=0.0.0.0
PORT=4173
